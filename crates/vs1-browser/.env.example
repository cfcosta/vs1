# Pass these as environment variables; the CLI does not read .env files.
VS1_DEVICE=cuda
CDP_URL=http://127.0.0.1:9222
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Only needed for --backend typesafe, never for local decisions:
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
