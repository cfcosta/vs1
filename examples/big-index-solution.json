{
  "mode": "constrained",
  "source": {
    "kind": "file",
    "path": "../crates/vs1-browser/assets/tasks.html",
    "query": "case=big-index"
  },
  "goal": "Open the documentation page about rate limits and quotas.",
  "steps": [
    {
      "instruction": "Jump to the Rate limits section in the documentation index.",
      "kind": "click",
      "role": "link",
      "terms": "Rate limits section",
      "after": [
        {
          "check": "url_suffix",
          "suffix": "#rate-limits"
        },
        {
          "check": "text",
          "contains": "Rate limits and quotas"
        }
      ]
    },
    {
      "instruction": "Open the exact link titled Rate limits and quotas.",
      "kind": "click",
      "role": "link",
      "terms": "Rate limits and quotas",
      "after": [
        {
          "check": "url_suffix",
          "suffix": "#doc-rate-limits-and-quotas"
        },
        {
          "check": "title",
          "equals": "Rate limits and quotas · Local tasks"
        },
        {
          "check": "text",
          "contains": "Rate limits and quotas"
        }
      ]
    }
  ],
  "completion": [
    {
      "check": "url_suffix",
      "suffix": "#doc-rate-limits-and-quotas"
    },
    {
      "check": "title",
      "equals": "Rate limits and quotas · Local tasks"
    },
    {
      "check": "text",
      "contains": "Rate limits and quotas"
    }
  ],
  "scripts": {
    "shuffleSections": ["renderDocumentationIndex('shuffled');"],
    "placeTargetSectionLast": ["renderDocumentationIndex('target-last');"]
  },
  "variants": [
    {
      "name": "base"
    },
    {
      "name": "shuffled",
      "setup": ["shuffleSections"]
    },
    {
      "name": "target-last",
      "setup": ["placeTargetSectionLast"]
    }
  ],
  "verify": [
    "location.hash === \"#doc-rate-limits-and-quotas\" && document.title === \"Rate limits and quotas · Local tasks\" && document.querySelector(\"#documentation-page h1\")?.textContent === \"Rate limits and quotas\" && window.__taskState?.openPage === \"Rate limits and quotas\""
  ]
}
