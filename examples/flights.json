{
  "mode": "agent",
  "source": {
    "kind": "url",
    "url": "https://www.google.com/travel/flights?hl=en"
  },
  "goal": "Find one-way flights from Zurich to London on September 20, 2026, for one adult in economy. Stop when matching flight options are visible. Do not select or book a flight.",
  "variants": [
    {
      "name": "base"
    }
  ],
  "verify": [
    "(() => {",
    "  const url = new URL(page.url);",
    "  const encoded = (url.searchParams.get('tfs') || '').replace(/-/g, '+').replace(/_/g, '/');",
    "  let dateInUrl = false;",
    "  try { dateInUrl = atob(encoded.padEnd(Math.ceil(encoded.length / 4) * 4, '=')).includes('2026-09-20'); } catch (_) {}",
    "  const values = Object.fromEntries(page.actions.map(a => [a.label.trim(), a.value]));",
    "  const field = (label, value) => page.actions.some(a => a.kind === 'fill' && (a.label.trim() === label || a.label.trim().startsWith(label + ' ')) && a.value === value);",
    "  const flights = page.actions.filter(a => a.label.includes('Select flight'));",
    "  return url.hostname === 'www.google.com' && url.pathname === '/travel/flights/search'",
    "    && values['Change ticket type. One way'] === 'One way'",
    "    && field('Where from?', 'Zürich') && field('Where to?', 'London')",
    "    && values['Departure'] === 'Sun, Sep 20'",
    "    && (dateInUrl || page.text.includes('departing 2026-09-20'))",
    "    && flights.length > 0 && flights.every(a => a.label.includes('Sunday, September 20'));",
    "})()"
  ]
}
