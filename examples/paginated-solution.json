{
  "mode": "constrained",
  "source": {
    "kind": "file",
    "path": "../crates/vs1-browser/assets/tasks.html",
    "query": "case=paginated"
  },
  "goal": "Open the product page for the Walnut desk organizer.",
  "steps": [
    {
      "instruction": "Click Next to open page 2 of the product catalog.",
      "kind": "click",
      "role": "button",
      "terms": "Next",
      "after": [
        {
          "check": "url_suffix",
          "suffix": "#catalog-page-2"
        },
        {
          "check": "text",
          "contains": "Page 2 of 3"
        }
      ]
    },
    {
      "instruction": "Click Next to open page 3 of the product catalog.",
      "kind": "click",
      "role": "button",
      "terms": "Next",
      "after": [
        {
          "check": "url_suffix",
          "suffix": "#catalog-page-3"
        },
        {
          "check": "text",
          "contains": "Page 3 of 3"
        }
      ]
    },
    {
      "instruction": "Open the Walnut desk organizer product page.",
      "kind": "click",
      "role": "link",
      "terms": "Walnut desk organizer",
      "after": [
        {
          "check": "url_suffix",
          "suffix": "#product-walnut-desk-organizer"
        },
        {
          "check": "title",
          "equals": "Walnut desk organizer · Local tasks"
        },
        {
          "check": "text",
          "contains": "Walnut desk organizer"
        }
      ]
    }
  ],
  "completion": [
    {
      "check": "url_suffix",
      "suffix": "#product-walnut-desk-organizer"
    },
    {
      "check": "title",
      "equals": "Walnut desk organizer · Local tasks"
    },
    {
      "check": "text",
      "contains": "Walnut desk organizer"
    }
  ],
  "variants": [
    {
      "name": "base"
    }
  ],
  "verify": [
    "location.hash === '#product-walnut-desk-organizer' && document.title === 'Walnut desk organizer · Local tasks' && document.querySelector('#catalog-product h1')?.textContent === 'Walnut desk organizer' && window.__taskState?.openProduct === 'Walnut desk organizer'"
  ]
}
