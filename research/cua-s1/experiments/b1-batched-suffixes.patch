+    pub(super) fn forward_suffixes(
+        &self,
+        x: &Tensor,
+        lengths: &[usize],
+        state: &DeltaNetState,
+    ) -> Result<Tensor> {
+        let rows = x.dim(0)?;
+        let mixed = self.in_proj_qkv.forward(x)?;
+        let a = self.in_proj_a.forward(x)?;
+        let b = self.in_proj_b.forward(x)?;
+        let mut convolved = Vec::with_capacity(lengths.len());
+        let mut start = 0;
+        for &len in lengths {
+            let (output, _) = convolve_causally_with_silu_with_state(
+                &mixed.narrow(0, start, len)?,
+                &self.conv_weight,
+                Some(&state.conv_input),
+            )?;
+            convolved.push(output);
+            start += len;
+        }
+        let mixed = Tensor::cat(&convolved, 0)?;
+        let (query, key, value, beta, decay) =
+            self.normalize_delta_inputs(&mixed, &a, &b)?;
+        let mut outputs = Vec::with_capacity(lengths.len());
+        let mut start = 0;
+        for &len in lengths {
+            let query = query.narrow(0, start, len)?.contiguous()?;
+            let key = key.narrow(0, start, len)?.contiguous()?;
+            let value = value.narrow(0, start, len)?;
+            let beta = beta.narrow(0, start, len)?.contiguous()?;
+            let decay = decay.narrow(0, start, len)?.contiguous()?;
+            let initial_state = Some(&state.recurrent);
+            #[cfg(feature = "cuda")]
+            let (output, _) = if x.device().is_cuda() {
+                super::delta_rule_cuda::apply_delta_rule_with_state(
+                    &query,
+                    &key,
+                    &value,
+                    &beta,
+                    &decay,
+                    initial_state,
+                )?
+            } else {
+                apply_delta_rule_with_state(
+                    &query,
+                    &key,
+                    &value,
+                    &beta,
+                    &decay,
+                    initial_state,
+                )?
+            };
+            #[cfg(not(feature = "cuda"))]
+            let (output, _) = apply_delta_rule_with_state(
+                &query,
+                &key,
+                &value,
+                &beta,
+                &decay,
+                initial_state,
+            )?;
+            outputs.push(output);
+            start += len;
+        }
+        let output = Tensor::cat(&outputs, 0)?.to_dtype(x.dtype())?;
+        let gate = self.in_proj_z.forward(x)?.reshape(output.shape())?;
+        let output = normalize_rms_gated(
+            &output,
+            &self.norm_weight,
+            &gate,
+            self.rms_norm_eps,
+        )?;
+        self.out_proj.forward(
+            &output
+                .reshape((rows, self.num_value_heads * self.value_head_dim))?,
+        )
+    }
