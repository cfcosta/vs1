+    pub(super) fn forward_suffixes(
+        &self,
+        x: &Tensor,
+        lengths: &[usize],
+        cache: &KvCache,
+    ) -> Result<Tensor> {
+        let rows = x.dim(0)?;
+        let (heads, cached_len, head_dim) = cache.key.dims3()?;
+        if heads != self.num_kv_heads
+            || head_dim != self.head_dim
+            || cache.value.shape() != cache.key.shape()
+            || cache.key.dtype() != x.dtype()
+            || cache.value.dtype() != x.dtype()
+            || !cache.key.device().same_device(x.device())
+            || !cache.value.device().same_device(x.device())
+        {
+            candle_core::bail!(
+                "full attention cache has incompatible shape, dtype or device"
+            )
+        }
+        let query_gate = self.q_proj.forward(x)?.reshape((
+            rows,
+            self.num_heads,
+            2 * self.head_dim,
+        ))?;
+        let query = query_gate.narrow(D::Minus1, 0, self.head_dim)?;
+        let gate = query_gate
+            .narrow(D::Minus1, self.head_dim, self.head_dim)?
+            .reshape((rows, self.num_heads * self.head_dim))?;
+        let query = normalize_rms(&query, &self.q_norm, self.rms_norm_eps)?
+            .transpose(0, 1)?;
+        let key = self.k_proj.forward(x)?.reshape((
+            rows,
+            self.num_kv_heads,
+            self.head_dim,
+        ))?;
+        let key = normalize_rms(&key, &self.k_norm, self.rms_norm_eps)?
+            .transpose(0, 1)?;
+        let value = self
+            .v_proj
+            .forward(x)?
+            .reshape((rows, self.num_kv_heads, self.head_dim))?
+            .transpose(0, 1)?;
+        // Every suffix starts at the same absolute rotary position.
+        let positions: Vec<_> = lengths
+            .iter()
+            .flat_map(|&len| (cached_len..cached_len + len).map(|i| i as f32))
+            .collect();
+        let freqs = Tensor::new(positions.as_slice(), x.device())?
+            .unsqueeze(1)?
+            .broadcast_mul(&self.inv_freq.unsqueeze(0)?)?;
+        let freqs = Tensor::cat(&[&freqs, &freqs], D::Minus1)?;
+        let cos = freqs.cos()?.to_dtype(x.dtype())?;
+        let sin = freqs.sin()?.to_dtype(x.dtype())?;
+        let query = apply_rotary(&query, &cos, &sin)?;
+        let key = apply_rotary(&key, &cos, &sin)?;
+        let mut outputs = Vec::with_capacity(lengths.len());
+        let mut start = 0;
+        for &len in lengths {
+            // Only one suffix's combined KV is live at a time.
+            let key =
+                Tensor::cat(&[&cache.key, &key.narrow(1, start, len)?], 1)?;
+            let value =
+                Tensor::cat(&[&cache.value, &value.narrow(1, start, len)?], 1)?;
+            outputs.push(attend_causally(
+                &query.narrow(1, start, len)?,
+                &key,
+                &value,
+            )?);
+            start += len;
+        }
+        let output = Tensor::cat(&outputs, 0)?
+            .reshape((rows, self.num_heads * self.head_dim))?;
+        self.o_proj.forward(&(output * ops::sigmoid(&gate)?)?)
+    }
 }
 
