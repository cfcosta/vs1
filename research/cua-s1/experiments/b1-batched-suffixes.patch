+    /// Scores independent nonempty suffixes in one batch from an unchanged prefix.
+    pub fn score_suffixes(
+        &self,
+        prefix: &PrefixState,
+        suffixes: &[(&[u32], &[u32])],
+    ) -> Result<Vec<CuaS1Prediction>> {
+        if prefix.layer_states.len() != self.layers.len() {
+            return Err(SystemOneError::Config(
+                "prefix state must contain one state per decoder layer".into(),
+            ));
+        }
+        if suffixes.is_empty() {
+            return Ok(Vec::new());
+        }
+        let vocab_size = self.embed_tokens.dim(0)?;
+        let mut ids = Vec::new();
+        let mut lengths = Vec::with_capacity(suffixes.len());
+        let mut last_rows = Vec::with_capacity(suffixes.len());
+        let mut batch_letter_ids = Vec::new();
+        for &(suffix_ids, letter_ids) in suffixes {
+            if suffix_ids.is_empty() || !(1..=26).contains(&letter_ids.len()) {
+                return Err(SystemOneError::Config(
+                    "text decoder requires nonempty suffixes and 1..=26 letter token ids".into(),
+                ));
+            }
+            if letter_ids.iter().any(|&id| id as usize >= vocab_size) {
+                return Err(SystemOneError::Config(
+                    "text decoder token id is outside the embedding vocabulary"
+                        .into(),
+                ));
+            }
+            ids.extend_from_slice(suffix_ids);
+            lengths.push(suffix_ids.len());
+            last_rows.push((ids.len() - 1) as u32);
+            batch_letter_ids.extend_from_slice(letter_ids);
+        }
+        let mut hidden = self.embed(&ids)?;
+        for (layer, state) in self.layers.iter().zip(&prefix.layer_states) {
+            hidden = layer.forward_suffixes(&hidden, &lengths, state)?;
+        }
+        let last_rows = Tensor::new(last_rows.as_slice(), hidden.device())?;
+        let last = hidden.index_select(&last_rows, 0)?;
+        let last = normalize_rms(&last, &self.norm, self.rms_norm_eps)?;
+        // Project the last rows together onto only the union of requested letters.
+        batch_letter_ids.sort_unstable();
+        batch_letter_ids.dedup();
