+// Mirrors cua_s1_policy in the vs1-browser binary; it has no shared library.
+fn drop_duplicate_options(options: &mut Vec<CuaS1Option>) -> usize {
+    let original_count = options.len();
+    let mut seen = std::collections::HashSet::new();
+    options.retain(|option| {
+        option.action == "fill"
+            || option.role == "page"
+            || matches!(option.element_id.as_str(), "DONE" | "BLOCKED")
+            || seen.insert((
+                option.role.clone(),
+                option.label.clone(),
+                option.action.clone(),
+            ))
+    });
+    original_count - options.len()
+}
