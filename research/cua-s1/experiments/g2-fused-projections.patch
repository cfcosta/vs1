 use candle_core::{D, DType, Result, Tensor};
 use candle_nn::{Linear, Module};
 
+/// Concatenates bias-free weights, retaining separate projections as views.
+pub(super) fn concatenate_projections(
+    projections: &mut [&mut Linear],
+) -> Result<Linear> {
+    let weights: Vec<_> = projections.iter().map(|p| p.weight()).collect();
+    let weight = Tensor::cat(&weights, 0)?;
+    let mut offset = 0;
+    for projection in projections {
+        let width = projection.weight().dim(0)?;
+        **projection = Linear::new(weight.narrow(0, offset, width)?, None);
+        offset += width;
+    }
+    Ok(Linear::new(weight, None))
+}
