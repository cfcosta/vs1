+#[derive(Debug, Clone, Copy, Default)]
+pub struct GemmTuningStats {
+    pub keys_tuned: usize,
+    pub non_default_keys: usize,
+    pub tuning_time: Duration,
+}
+
+static GEMM_TUNING_STATS: Mutex<GemmTuningStats> =
+    Mutex::new(GemmTuningStats {
+        keys_tuned: 0,
+        non_default_keys: 0,
+        tuning_time: Duration::ZERO,
+    });
+
+/// Cumulative Cua-S1 projection tuning cost across all models in this process.
+pub fn read_gemm_tuning_stats() -> GemmTuningStats {
+    *GEMM_TUNING_STATS.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct GemmKey {
+    n: usize,
+    k: usize,
+    m: usize,
+    weight_strides: [usize; 2],
+    dtype: DType,
+    has_reduced_precision: bool,
+}
+
+struct TunedGemm {
+    plan: Option<CachedPlan>,
+    #[cfg(test)]
+    default_ms: f64,
+    #[cfg(test)]
+    chosen_ms: f64,
+}
+
+struct TuningState {
+    choices: HashMap<GemmKey, TunedGemm>,
+    engine: Engine,
+    device: candle_core::Device,
+}
+// SAFETY: GemmCache's mutex exclusively owns the descriptors and scratch buffer.
+// Engine binds the context and orders scratch reuse across host threads.
+unsafe impl Send for TuningState {}
+
+pub(crate) struct GemmCache {
+    state: Mutex<Option<TuningState>>,
+    is_enabled: bool,
+}
+
+impl Default for GemmCache {
+    fn default() -> Self {
+        Self {
+            state: Mutex::new(None),
+            is_enabled: std::env::var_os("VS1_CUA_S1_GEMM_AUTOTUNE")
+                .is_none_or(|value| value != "0"),
+        }
+    }
+}
+
+impl GemmCache {
+    pub(crate) fn project(
+        &self,
+        xs: &Tensor,
+        linear: &Linear,
+    ) -> candle_core::Result<Tensor> {
+        let weight = linear.weight();
+        if !self.is_enabled
+            || xs.rank() != 2
+            || weight.rank() != 2
+            || xs.dtype() != DType::BF16
+            || weight.dtype() != DType::BF16
+            || !xs.device().is_cuda()
+            || !xs.device().same_device(weight.device())
+            || linear.bias().is_some()
+            || !xs.is_contiguous()
+            || !weight.is_contiguous()
+            || !xs.layout().start_offset().is_multiple_of(128)
+            || !weight.layout().start_offset().is_multiple_of(128)
+        {
+            return xs.apply(linear);
+        }
+        let (m, k) = xs.dims2()?;
+        let (n, weight_k) = weight.dims2()?;
+        if m == 0 || n == 0 || k == 0 || weight_k != k {
+            return xs.apply(linear);
+        }
+        let key = GemmKey {
+            n,
+            k,
+            m,
+            weight_strides: [weight.stride()[0], weight.stride()[1]],
+            dtype: weight.dtype(),
+            has_reduced_precision:
+                candle_core::cuda_backend::gemm_reduced_precision_bf16(),
+        };
+        let mut guard = self.state.lock().map_err(err)?;
+        let started = guard.is_none().then(Instant::now);
+        if guard.is_none() {
+            *guard = Some(TuningState {
+                choices: HashMap::new(),
+                engine: Engine::new(xs).map_err(err)?,
+                device: xs.device().clone(),
+            });
+        }
+        let state = guard.as_mut().unwrap();
+        if !state.device.same_device(xs.device()) {
+            return xs.apply(linear);
+        }
+        if let std::collections::hash_map::Entry::Vacant(entry) =
+            state.choices.entry(key)
+        {
+            let started = started.unwrap_or_else(Instant::now);
+            let choice = tune_gemm(&state.engine, xs, linear).map_err(err)?;
+            let mut stats =
+                GEMM_TUNING_STATS.lock().unwrap_or_else(|e| e.into_inner());
+            stats.keys_tuned += 1;
+            stats.non_default_keys += usize::from(choice.plan.is_some());
+            stats.tuning_time += started.elapsed();
+            entry.insert(choice);
+        }
+        match &state.choices[&key].plan {
+            Some(cached) => output(
+                &state.engine,
+                &cached.plan,
+                &cached.algorithm,
+                xs,
+                linear,
+            )
+            .map_err(err),
+            None => xs.apply(linear),
+        }
+    }
+}
+
+fn measure_gemm_ms(
+    xs: &Tensor,
+    mut project: impl FnMut() -> Result<Tensor>,
+) -> Result<f64> {
+    let stream = xs.device().as_cuda_device()?.cuda_stream();
+    std::hint::black_box(project()?);
+    let mut samples = [0.; 3];
+    for sample in &mut samples {
+        stream.synchronize()?;
+        let start =
+            stream.record_event(Some(CUevent_flags::CU_EVENT_DEFAULT))?;
+        std::hint::black_box(project()?);
+        let end = stream.record_event(Some(CUevent_flags::CU_EVENT_DEFAULT))?;
+        end.synchronize()?;
+        *sample = f64::from(start.elapsed_ms(&end)?);
+    }
+    samples.sort_by(f64::total_cmp);
+    ensure!(
+        samples[1].is_finite() && samples[1] > 0.,
+        "invalid GEMM timing"
+    );
+    Ok(samples[1])
+}
+
+fn tune_gemm(
+    engine: &Engine,
+    xs: &Tensor,
+    linear: &Linear,
+) -> Result<TunedGemm> {
+    let (m, k) = xs.dims2()?;
+    let n = linear.weight().dim(0)?;
+    let plan = Plan::new([m, n, k])?;
+    let mut default_ms = measure_gemm_ms(xs, || Ok(xs.apply(linear)?))?;
+    let mut best_ms = f64::INFINITY;
+    let mut best_algorithm = None;
+    // Unsupported heuristics keep Candle's default. Never search beyond eight.
+    for candidate in plan.query_algorithms(engine, 8).unwrap_or_default() {
+        if candidate.state != sys::cublasStatus_t::CUBLAS_STATUS_SUCCESS
+            || candidate.workspaceSize > WORKSPACE
+        {
+            continue;
+        }
+        match measure_gemm_ms(xs, || {
+            output(engine, &plan, &candidate.algo, xs, linear)
+        }) {
+            Ok(ms) if ms < best_ms => {
+                best_ms = ms;
+                best_algorithm = Some(candidate.algo);
+            }
+            Ok(_) => {}
+            Err(_) => xs.device().synchronize()?,
+        }
+    }
+    // Recheck the default after GPU warmup; use the faster baseline so clock
+    // ramp-up cannot by itself qualify a candidate for the 3% saving.
+    default_ms = default_ms.min(measure_gemm_ms(xs, || Ok(xs.apply(linear)?))?);
+    let algorithm = best_algorithm.filter(|_| best_ms <= default_ms * 0.97);
+    Ok(TunedGemm {
+        #[cfg(test)]
+        default_ms,
+        #[cfg(test)]
+        chosen_ms: if algorithm.is_some() {
+            best_ms
+        } else {
+            default_ms
+        },
+        plan: algorithm.map(|algorithm| CachedPlan { plan, algorithm }),
+    })
+}
