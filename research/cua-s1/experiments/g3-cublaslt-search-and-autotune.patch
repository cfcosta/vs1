+    fn tunes_cua_s1_projections_within_bf16_tolerance() -> Result<()> {
+        let device = candle_core::Device::new_cuda(0)?;
+        device.set_seed(42)?;
+        let cache = std::sync::Arc::new(GemmCache {
+            state: Mutex::new(None),
