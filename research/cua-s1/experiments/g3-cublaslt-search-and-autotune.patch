+                    ensure!(
+                        after.non_default_keys
+                            == before.non_default_keys
+                                + usize::from(chosen.plan.is_some())
+                    );
+                    println!(
+                        "{name} M={m} N={n} K={k}: choice={algorithm}, default_ms={:.6}, chosen_ms={:.6}, speedup={:.3}, tuning_ms={:.3}",
+                        chosen.default_ms,
+                        chosen.chosen_ms,
+                        chosen.default_ms / chosen.chosen_ms,
+                        (after.tuning_time - before.tuning_time).as_secs_f64()
+                            * 1000.
+                    );
+                }
