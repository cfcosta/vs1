+            let actual = actual
+                .to_dtype(DType::F32)?
+                .flatten_all()?
+                .to_vec1::<f32>()?;
+            let expected = expected
+                .to_dtype(DType::F32)?
+                .flatten_all()?
+                .to_vec1::<f32>()?;
+            ensure!(actual.len() == expected.len());
+            let mut max_ratio = 0f32;
+            for (actual, expected) in actual.into_iter().zip(expected) {
+                let ratio = (actual - expected).abs()
+                    / (tolerance + tolerance * expected.abs());
+                ensure!(
+                    ratio.is_finite() && ratio <= 1.,
+                    "expected {expected}, got {actual}, tolerance ratio {ratio}"
+                );
+                max_ratio = max_ratio.max(ratio);
+            }
+            println!("maximum combined tolerance ratio: {max_ratio}");
+            Ok(())
+        };
+        let mut keys = 0;
+        for (name, n, k) in [
+            ("down_proj", 2560, 9216),
+            ("in_proj_qkv/q_proj", 8192, 2560),
+            ("in_proj_a/in_proj_b", 32, 2560),
+        ] {
+            for m in [1152, 1860] {
+                let xs = Tensor::randn(0f32, 1., (m, k), &device)?
+                    .to_dtype(DType::BF16)?;
+                let linear = Linear::new(
+                    Tensor::randn(
+                        0f32,
+                        (k as f32).sqrt().recip(),
+                        (n, k),
+                        &device,
+                    )?
+                    .to_dtype(DType::BF16)?,
+                    None,
+                );
+                let expected = xs.apply(&linear)?;
+                let before = read_gemm_tuning_stats();
+                assert_close(&cache.project(&xs, &linear)?, &expected)?;
+                let after = read_gemm_tuning_stats();
+                keys += 1;
+                ensure!(after.keys_tuned == before.keys_tuned + 1);
+                {
+                    let guard = cache.state.lock().unwrap();
+                    let state = guard.as_ref().unwrap();
+                    ensure!(state.choices.len() == keys);
+                    let chosen = state
+                        .choices
+                        .iter()
+                        .find(|(key, _)| key.n == n && key.k == k && key.m == m)
+                        .unwrap()
+                        .1;
+                    let algorithm = match &chosen.plan {
+                        Some(cached) => {
+                            ensure!(
