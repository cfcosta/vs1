+                ensure!(reused.keys_tuned == after.keys_tuned);
+                ensure!(reused.non_default_keys == after.non_default_keys);
+                ensure!(reused.tuning_time == after.tuning_time);
+            }
+        }
+        println!("process tuning totals: {:?}", read_gemm_tuning_stats());
+        Ok(())
+    }
