@@ -0,0 +1,21 @@
+extern "C" __global__ void features(const float *logits, const unsigned *counts, float *out, int batch, int width) {
+    int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row >= batch) return;
+    const float *z = logits + row * width;
+    int count = counts[row];
+    float maximum = -1.0f/0.0f;
+    for (int j=0; j<width; ++j) maximum = fmaxf(maximum, j<count ? z[j] : -1e4f);
+    float sum = 0;
+    for (int j=0; j<width; ++j) sum += expf((j<count ? z[j] : -1e4f) - maximum);
+    float top1 = 0, top2 = 0, entropy = 0;
+    for (int j=0; j<width; ++j) {
+        float p = expf((j<count ? z[j] : -1e4f) - maximum) / sum;
+        entropy += p * logf(fmaxf(p, 1e-9f));
+        if (p > top1) { top2 = top1; top1 = p; } else if (p > top2) top2 = p;
+    }
+    float k = count > 2 ? count : 2;
+    out[row*4] = top1;
+    out[row*4+1] = top1-top2;
+    out[row*4+2] = -entropy/logf(k);
+    out[row*4+3] = k/255.0f;
+}
