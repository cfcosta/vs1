+    fn marker_logits_packed(&self, c: &Collated) -> Result<(Tensor, Vec<Vec<f32>>)> {
+        use candle_core::cuda_backend::{WrapErr, cudarc::driver::sys};
+        let mut key = vec![c.batch, c.seq_len, c.max_markers];
+        key.extend(&c.lens);
+        key.extend(c.kinds.iter().map(|&x| x as usize));
+        key.extend(c.marker_pos.iter().map(|&x| x as usize));
+        let packed: Vec<_> = c.input_ids.chunks(c.seq_len).zip(&c.lens)
+            .flat_map(|(row,&len)| row[..len].iter().copied()).collect();
+        let mut cache = self.graph.lock().unwrap();
+        if cache.as_ref().is_none_or(|g| g.key != key) {
+            // Keep only one shape; release its graph before replacing encoder caches.
+            *cache = None;
+            let dev = self.device.as_cuda_device()?;
+            let stream = dev.cuda_stream();
+            let _cache_guard = dev.enable_cuda_graph_htod_cache();
+            let input = Tensor::from_vec(packed.clone(), packed.len(), &self.device)?;
+            let indices = Tensor::arange(0u32, packed.len() as u32, &self.device)?;
+            // Prepare all value-dependent and large host uploads outside capture.
+            let token_kinds: Vec<u32> = c.kinds.iter().zip(&c.lens)
+                .flat_map(|(&kind,&len)| std::iter::repeat_n(kind,len)).collect();
+            let kinds = Tensor::from_vec(token_kinds, packed.len(), &self.device)?;
+            let mut offsets = vec![];
+            let mut start = 0u32;
+            for &len in &c.lens { offsets.push(start); start += len as u32; }
+            let marker: Vec<_> = c.marker_pos.chunks(c.max_markers.max(1)).zip(&offsets)
+                .flat_map(|(row,&offset)| row.iter().map(move |&m| m+offset)).collect();
+            let marker = Tensor::from_vec(marker, c.batch*c.max_markers, &self.device)?;
+            let offsets = Tensor::from_vec(offsets, c.batch, &self.device)?;
+            let (seqlens, max_len) = crate::modernbert::cumulative_seqlens(&c.lens, &self.device)?;
+            let forward = || -> Result<(Tensor,Tensor)> {
+                let hidden = self.encoder.forward_prepacked(&input, &c.lens)?;
+                let (_, h) = hidden.dims2()?;
+                let mut hidden = (hidden + self.type_emb.index_select(&kinds,0)?)?;
+                for layer in &self.head { hidden = layer.forward_packed(&hidden,&seqlens,max_len)?; }
+                let marked = hidden.index_select(&marker,0)?.reshape((c.batch,c.max_markers,h))?;
+                let logits = self.scorer.forward(&marked)?;
+                let pooled = hidden.index_select(&offsets,0)?.to_dtype(DType::F32)?.contiguous()?;
+                Ok((pooled,logits))
+            };
+            forward()?;
+            self.device.synchronize()?;
+            stream.begin_capture(sys::CUstreamCaptureMode::CU_STREAM_CAPTURE_MODE_THREAD_LOCAL).w()?;
+            let captured = forward();
+            let graph = stream.end_capture(sys::CUgraphInstantiate_flags::CUDA_GRAPH_INSTANTIATE_FLAG_AUTO_FREE_ON_LAUNCH).w()?;
+            let (pooled, logits) = captured?;
+            let graph = graph.ok_or_else(|| candle_core::Error::Msg("empty graph".into()))?;
+            graph.launch().w()?;
+            // Captured operations refer to these prepared buffers. Keep them alive.
+            // Initial prototype retains them through the stored tensors below.
+            *cache = Some(MarkerGraph { key, input, indices, pooled, logits, graph,
+                _prepared: vec![kinds, marker, offsets, seqlens] });
+        } else {
+            let g = cache.as_ref().unwrap();
+            let input = Tensor::from_vec(packed.clone(), packed.len(), &self.device)?;
+            g.input.scatter_set(&g.indices, &input, 0)?;
+            g.graph.launch().w()?;
+        }
+        let g = cache.as_ref().unwrap();
+        Ok((g.pooled.clone(), g.logits.to_vec2::<f32>()?))
     }
 
