diff --git a/crates/vs1/src/qkv_cuda.rs b/crates/vs1/src/qkv_cuda.rs
new file mode 100644
index 0000000000..a9ec63d510
--- /dev/null
+++ b/crates/vs1/src/qkv_cuda.rs
@@ -0,0 +1,68 @@
+use candle_core::{CpuStorage, CustomOp3, Layout, Result, Shape, Tensor};
+use candle_core::cuda_backend::{CudaDType, WrapErr, cudarc::{driver::{CudaSlice, DeviceRepr, LaunchConfig, PushKernelArg}, nvrtc}};
+struct Split { heads: usize, rotate: bool }
+impl CustomOp3 for Split {
+    fn name(&self) -> &'static str { "split_qkv_rope" }
+    fn cpu_fwd(&self, _: &CpuStorage, _: &Layout, _: &CpuStorage, _: &Layout, _: &CpuStorage, _: &Layout) -> Result<(CpuStorage, Shape)> {
+        candle_core::bail!("CUDA only")
+    }
+    fn cuda_fwd(&self, src: &candle_core::CudaStorage, sl: &Layout,
+        cos: &candle_core::CudaStorage, cl: &Layout, sin: &candle_core::CudaStorage, nl: &Layout) -> Result<(candle_core::CudaStorage, Shape)> {
+        use candle_core::{backend::BackendStorage, cuda_backend::CudaStorageSlice};
+        static PTX: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+        let ptx = PTX.get_or_init(|| nvrtc::compile_ptx(include_str!("qkv_rope.cu")).expect("compile qkv").to_src());
+        let (total, width) = sl.shape().dims2()?;
+        let d = width / 3 / self.heads;
+        let dev = src.device();
+        fn launch<T: CudaDType + DeviceRepr>(src: &CudaSlice<T>, offset: usize, cos: &candle_core::CudaStorage,
+            cl: &Layout, sin: &candle_core::CudaStorage, nl: &Layout, dev: &candle_core::CudaDevice,
+            ptx: &str, name: &str, total: usize, heads: usize, d: usize, rotate: bool) -> Result<candle_core::CudaStorage> {
+            let f = dev.get_or_load_custom_func(name,"vs1_qkv",ptx)?;
+            let src = src.slice(offset..);
+            let cos = cos.as_cuda_slice::<T>()?.slice(cl.start_offset()..);
+            let sin = sin.as_cuda_slice::<T>()?.slice(nl.start_offset()..);
+            let mut out = unsafe { dev.alloc::<T>(3*total*heads*d)? };
+            let mut b = f.builder();
+            let (t,h,d,r) = (total as i32,heads as i32,d as i32,i32::from(rotate));
+            b.arg(&src).arg(&cos).arg(&sin).arg(&mut out).arg(&t).arg(&h).arg(&d).arg(&r);
+            unsafe { b.launch(LaunchConfig::for_num_elems((3*total*heads*d as usize/2) as u32)) }.w()?;
+            Ok(candle_core::CudaStorage::wrap_cuda_slice(out,dev.clone()))
+        }
+        let out = match &src.slice {
+            CudaStorageSlice::BF16(s) => launch(s,sl.start_offset(),cos,cl,sin,nl,dev,ptx,"qkv_bf16",total,self.heads,d,self.rotate)?,
+            CudaStorageSlice::F32(s) => launch(s,sl.start_offset(),cos,cl,sin,nl,dev,ptx,"qkv_f32",total,self.heads,d,self.rotate)?,
+            _ => candle_core::bail!("unsupported qkv dtype"),
+        };
+        Ok((out, (3,total,self.heads,d).into()))
+    }
+}
+pub fn split(src: &Tensor, cos: &Tensor, sin: &Tensor, heads: usize, rotate: bool) -> Result<(Tensor,Tensor,Tensor)> {
+    let out = src.apply_op3_no_bwd(cos,sin,&Split {heads,rotate})?;
+    Ok((out.get(0)?,out.get(1)?,out.get(2)?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    #[ignore = "requires CUDA"]
+    fn fused_layout_and_rope_are_exact() {
+        let dev = candle_core::Device::new_cuda(0).unwrap();
+        for dtype in [candle_core::DType::BF16, candle_core::DType::F32] {
+            let (tokens,heads,d) = (7,2,64);
+            let data: Vec<f32> = (0..tokens*3*heads*d).map(|i| (i as f32*0.137).sin()).collect();
+            let src = Tensor::from_vec(data,(tokens,3*heads*d),&dev).unwrap().to_dtype(dtype).unwrap();
+            let angles: Vec<f32> = (0..tokens*d/2).map(|i| i as f32/7.0).collect();
+            let cos = Tensor::from_vec(angles.iter().map(|x| x.cos()).collect::<Vec<_>>(),(tokens,d/2),&dev).unwrap().to_dtype(dtype).unwrap();
+            let sin = Tensor::from_vec(angles.iter().map(|x| x.sin()).collect::<Vec<_>>(),(tokens,d/2),&dev).unwrap().to_dtype(dtype).unwrap();
+            let actual = split(&src,&cos,&sin,heads,true).unwrap();
+            for (component,actual) in [actual.0,actual.1,actual.2].iter().enumerate() {
+                let plain = src.narrow(1,component*heads*d,heads*d).unwrap().contiguous().unwrap().reshape((1,tokens,heads,d)).unwrap();
+                let expected = if component < 2 { candle_nn::rotary_emb::rope_thd(&plain,&cos,&sin).unwrap() } else { plain };
+                let expected = expected.flatten_all().unwrap().to_dtype(candle_core::DType::F32).unwrap().to_vec1::<f32>().unwrap();
+                let actual = actual.flatten_all().unwrap().to_dtype(candle_core::DType::F32).unwrap().to_vec1::<f32>().unwrap();
+                assert_eq!(actual,expected,"{dtype:?}, component {component}");
+            }
+        }
+    }
+}
