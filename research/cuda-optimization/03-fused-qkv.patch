new file mode 100644
index 0000000000..bff41065ed
--- /dev/null
+++ b/crates/vs1/src/qkv_rope.cu
@@ -0,0 +1,29 @@
+__device__ float cvt(unsigned short x) { return __uint_as_float((unsigned)x << 16); }
+__device__ unsigned short rnd(float x) {
+    unsigned u=__float_as_uint(x);
+    if ((u & 0x7fffffffU) > 0x7f800000U) return (u >> 16) | 0x40;
+    return (u + 0x7fff + ((u >> 16) & 1)) >> 16;
+}
+__device__ float add(float a,float b) {return a+b;}
+__device__ float sub(float a,float b) {return a-b;}
+__device__ float mul(float a,float b) {return a*b;}
+__device__ unsigned short add(unsigned short a,unsigned short b) {return rnd(cvt(a)+cvt(b));}
+__device__ unsigned short sub(unsigned short a,unsigned short b) {return rnd(cvt(a)-cvt(b));}
+__device__ unsigned short mul(unsigned short a,unsigned short b) {return rnd(cvt(a)*cvt(b));}
+template<class T> __device__ void split(const T* src,const T* cos,const T* sin,T* out,int total,int heads,int d,int rotate) {
+    int idx=blockIdx.x*blockDim.x+threadIdx.x;
+    int plane=total*heads*d/2;
+    if(idx>=3*plane)return;
+    int component=idx/plane, local=idx%plane;
+    int row=local/(d/2), j=local%(d/2), token=row/heads, head=row%heads;
+    int a=token*3*heads*d+component*heads*d+head*d+j;
+    int o=component*2*plane+row*d+j;
+    T x=src[a],y=src[a+d/2];
+    if(rotate && component<2) {
+        int cs=token*(d/2)+j;
+        T c=cos[cs],s=sin[cs];
+        out[o]=sub(mul(x,c),mul(y,s)); out[o+d/2]=add(mul(x,s),mul(y,c));
+    } else {out[o]=x;out[o+d/2]=y;}
+}
+extern "C" __global__ void qkv_bf16(const unsigned short* x,const unsigned short* c,const unsigned short* s,unsigned short* o,int t,int h,int d,int r) {split(x,c,s,o,t,h,d,r);}
+extern "C" __global__ void qkv_f32(const float* x,const float* c,const float* s,float* o,int t,int h,int d,int r) {split(x,c,s,o,t,h,d,r);}
