+#[test]
+#[ignore = "requires CUDA and checkpoint; run alone"]
+fn pipeline_preserves_partial_and_mixed_batches() -> anyhow::Result<()> {
+    use std::sync::atomic::Ordering;
+    let model = model()?;
+    let all = cases();
+    let source = &all.iter().find(|(name, _)| name == "mixed128").unwrap().1;
+    for n in [0, 1, 31, 32, 33, 63, 65, 97, 128] {
+        let mut requests = source[..n].to_vec();
+        if n > 0 {
+            requests.extend(
+                all.iter()
+                    .find(|(name, _)| name == "browser_call5")
+                    .unwrap()
+                    .1
+                    .clone(),
+            );
+        }
+        REFERENCE_PIPELINE.store(true, Ordering::Relaxed);
+        let expected = snapshot(&model.system_one_batch(&requests)?);
+        REFERENCE_PIPELINE.store(false, Ordering::Relaxed);
+        assert_eq!(
+            snapshot(&model.system_one_batch(&requests)?),
+            expected,
+            "n={n}"
+        );
+    }
+    Ok(())
+}
