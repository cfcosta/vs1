+//! Experimental fused confidence features, one CUDA thread per question.
+use candle_core::{CpuStorage, CustomOp2, Layout, Result, Shape, Tensor};
+struct Features;
+impl CustomOp2 for Features {
+    fn name(&self) -> &'static str {
+        "action_features"
+    }
+    fn cpu_fwd(
+        &self,
+        _: &CpuStorage,
+        _: &Layout,
+        _: &CpuStorage,
+        _: &Layout,
+    ) -> Result<(CpuStorage, Shape)> {
+        candle_core::bail!("CUDA only")
+    }
+    fn cuda_fwd(
+        &self,
+        logits: &candle_core::CudaStorage,
+        ll: &Layout,
+        counts: &candle_core::CudaStorage,
+        cl: &Layout,
+    ) -> Result<(candle_core::CudaStorage, Shape)> {
+        use candle_core::{
+            backend::BackendStorage,
+            cuda_backend::{
+                WrapErr,
+                cudarc::{
+                    driver::{LaunchConfig, PushKernelArg},
+                    nvrtc,
+                },
+            },
+        };
+        static PTX: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+        let ptx = PTX.get_or_init(|| {
+            nvrtc::compile_ptx_with_opts(
+                include_str!("action_features.cu"),
+                nvrtc::CompileOptions {
+                    fmad: Some(false),
+                    ..Default::default()
+                },
+            )
+            .expect("compile action features")
+            .to_src()
+        });
+        let (batch, width) = ll.shape().dims2()?;
+        let dev = logits.device();
+        let func = dev.get_or_load_custom_func(
+            "features",
+            "vs1_action_features",
+            ptx,
+        )?;
+        let l = logits.as_cuda_slice::<f32>()?.slice(ll.start_offset()..);
+        let c = counts.as_cuda_slice::<u32>()?.slice(cl.start_offset()..);
+        let mut out = unsafe { dev.alloc::<f32>(batch * 4)? };
+        let mut b = func.builder();
+        let batch_i = batch as i32;
+        let width_i = width as i32;
+        b.arg(&l).arg(&c).arg(&mut out).arg(&batch_i).arg(&width_i);
+        unsafe { b.launch(LaunchConfig::for_num_elems(batch as u32)) }.w()?;
+        Ok((
+            candle_core::CudaStorage::wrap_cuda_slice(out, dev.clone()),
+            (batch, 4).into(),
+        ))
+    }
+}
+pub fn features(logits: &Tensor, counts: &[usize]) -> Result<Tensor> {
+    let counts = Tensor::from_vec(
+        counts.iter().map(|&x| x as u32).collect::<Vec<_>>(),
+        counts.len(),
+        logits.device(),
+    )?;
+    logits.apply_op2_no_bwd(&counts, &Features)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    #[ignore = "requires CUDA"]
+    fn confidence_features_match_host_exactly() {
+        let device = candle_core::Device::new_cuda(0).unwrap();
+        let width = 17;
+        let counts: Vec<_> = (0..64).map(|i| 2 + i % 16).collect();
+        let data: Vec<f32> = (0..64 * width)
+            .map(|i| ((i * 31 % 107) as f32 - 53.0) / 13.0)
+            .collect();
+        let input =
+            Tensor::from_vec(data.clone(), (64, width), &device).unwrap();
+        let actual =
+            features(&input, &counts).unwrap().to_vec2::<f32>().unwrap();
+        let mut mismatches = 0;
+        let mut max_difference = 0f32;
+        for ((row, &count), actual) in
+            data.chunks(width).zip(&counts).zip(actual)
+        {
+            let expected = crate::head::action_features(row, count);
+            for (a, e) in actual.iter().zip(expected) {
+                mismatches += usize::from(a.to_bits() != e.to_bits());
+                max_difference = max_difference.max((a - e).abs());
+            }
+        }
+        assert_eq!(
+            mismatches, 0,
+            "maximum absolute feature drift {max_difference}"
+        );
+    }
+    #[test]
+    #[ignore = "requires CUDA"]
+    fn confidence_features_broad_parity() {
+        let device = candle_core::Device::new_cuda(0).unwrap();
+        let mut seed = 713u32;
+        let mut report = vec![];
+        let mut total_mismatches = 0;
+        for width in [2usize, 3, 5, 17, 32, 128, 255] {
+            let batch = 512;
+            let counts: Vec<_> =
+                (0..batch).map(|i| 2 + i % (width - 1)).collect();
+            let data: Vec<f32> = (0..batch * width)
+                .map(|i| {
+                    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+                    let x = (seed >> 8) as f32 / 16777216.0;
+                    (x - 0.5)
+                        * [0.01, 1.0, 10.0, 100.0, 1000.0][(i / width) % 5]
+                })
+                .collect();
+            let input = Tensor::from_vec(data.clone(), (batch, width), &device)
+                .unwrap();
+            let actual =
+                features(&input, &counts).unwrap().to_vec2::<f32>().unwrap();
+            let mut mismatches = 0;
+            let mut max_difference = 0f32;
+            let mut first = None;
+            for (row_index, ((row, &count), actual)) in
+                data.chunks(width).zip(&counts).zip(actual).enumerate()
+            {
+                let expected = crate::head::action_features(row, count);
+                for (column, (&a, e)) in actual.iter().zip(expected).enumerate()
+                {
+                    if a.to_bits() != e.to_bits() {
+                        mismatches += 1;
+                        if first.is_none() {
+                            first = Some(
+                                serde_json::json!({"row":row_index,"column":column,"host":e,"gpu":a,"count":count,"logits":row}),
+                            );
+                        }
+                    }
+                    max_difference = max_difference.max((a - e).abs());
+                }
+            }
+            total_mismatches += mismatches;
+            report.push(serde_json::json!({"width":width,"rows":batch,"features":batch*4,"mismatches":mismatches,"max_absolute_error":max_difference,"first_difference":first}));
+        }
+        std::fs::write(
+            "../../research/fluid-inference/01-feature-parity.json",
+            serde_json::to_vec_pretty(&report).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(total_mismatches, 0);
+    }
+}
