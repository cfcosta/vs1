+    fn action_readback(
+        &self,
+        pooled: &Tensor,
+        features: &Tensor,
+    ) -> Result<Vec<Vec<f32>>> {
+        #[cfg(feature = "cuda")]
+        if self.device.is_cuda()
+            && std::env::var_os("VS1_EXPERIMENT_ACTION_GRAPH").is_some()
+        {
+            #[cfg(test)]
+            if crate::action_graph::REFERENCE
+                .load(std::sync::atomic::Ordering::Relaxed)
+            {
+                return Ok(self
+                    .act_head
+                    .forward(pooled, features)?
+                    .to_vec2()?);
+            }
+            return Ok(self
+                .action_graph
+                .lock()
+                .map_err(|e| candle_core::Error::Msg(e.to_string()))?
+                .run(&self.act_head, pooled, features)?);
+        }
+        Ok(self.act_head.forward(pooled, features)?.to_vec2()?)
+    }
