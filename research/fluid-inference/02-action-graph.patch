+//! Experimental bounded CUDA graph cache for the F32 action head only.
+use candle_core::{
+    DType,
+    Result,
+    Tensor,
+    cuda_backend::{
+        WrapErr,
+        cudarc::driver::{CudaGraph, sys},
+    },
+};
+
+use crate::head::ActionHead;
+
+#[derive(Default)]
+pub(crate) struct Cache {
+    entries: Vec<Entry>,
+    seen: Vec<(usize, usize)>,
+}
+struct Entry {
+    // Drop the executable before the tensors it references.
+    graph: CudaGraph,
+    input: Tensor,
+    indices: Tensor,
+    output: Tensor,
+    batch: usize,
+}
+// SAFETY: callers exclusively access the cache under the model mutex, including
+// replay and output readback. Each call binds its owning CUDA context.
+unsafe impl Send for Cache {}
+impl Drop for Cache {
+    fn drop(&mut self) {
+        for entry in &self.entries {
+            let _ = entry.input.device().synchronize();
+        }
+    }
+}
+
+#[cfg(test)]
+pub(crate) static REFERENCE: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+impl Cache {
+    pub(crate) fn run(
+        &mut self,
+        head: &ActionHead,
+        pooled: &Tensor,
+        features: &Tensor,
+    ) -> Result<Vec<Vec<f32>>> {
+        let dev = pooled.device().as_cuda_device()?;
+        let stream = dev.cuda_stream();
+        stream.context().bind_to_thread().w()?;
+        let (batch, _) = pooled.dims2()?;
+        let hit = self.entries.iter().position(|entry| entry.batch == batch);
+        if hit.is_none() {
+            if self.entries.len() >= 8 {
+                return head.forward(pooled, features)?.to_vec2();
+            }
+            if let Some((_, count)) =
+                self.seen.iter_mut().find(|(b, _)| *b == batch)
+            {
+                *count += 1;
+                if *count < 3 {
+                    return head.forward(pooled, features)?.to_vec2();
+                }
+            } else {
+                if self.seen.len() >= 32 {
+                    self.seen.remove(0);
+                }
+                self.seen.push((batch, 1));
+                return head.forward(pooled, features)?.to_vec2();
+            }
+            let values = Tensor::cat(&[pooled, features], 1)?;
+            let width = values.dim(1)?;
+            let input = values.flatten_all()?.copy()?;
+            let indices = Tensor::arange(
+                0u32,
+                input.elem_count() as u32,
+                pooled.device(),
+            )?;
+            let shaped = input.reshape((batch, width))?;
+            let _cache_guard = dev.enable_cuda_graph_htod_cache();
+            head.forward_input(&shaped)?;
+            pooled.device().synchronize()?;
+            stream.begin_capture(sys::CUstreamCaptureMode::CU_STREAM_CAPTURE_MODE_THREAD_LOCAL).w()?;
+            let output = head.forward_input(&shaped);
+            let graph = stream.end_capture(sys::CUgraphInstantiate_flags::CUDA_GRAPH_INSTANTIATE_FLAG_AUTO_FREE_ON_LAUNCH).w()?;
+            let output = output?;
+            let graph = graph.ok_or_else(|| {
+                candle_core::Error::Msg("empty action graph".into())
+            })?;
+            graph.launch().w()?;
+            self.entries.push(Entry {
+                graph,
+                input,
+                indices,
+                output,
+                batch,
+            });
+        } else {
+            let entry = &self.entries[hit.unwrap()];
+            let values = Tensor::cat(&[pooled, features], 1)?.flatten_all()?;
+            entry.input.scatter_set(&entry.indices, &values, 0)?;
+            entry.graph.launch().w()?;
+        }
+        self.entries[hit.unwrap_or(self.entries.len() - 1)]
+            .output
+            .to_dtype(DType::F32)?
+            .to_vec2()
+    }
+}
