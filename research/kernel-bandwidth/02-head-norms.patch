+    fn assert_bits(
+        name: &str,
+        actual: &Tensor,
+        expected: &Tensor,
+    ) -> Result<()> {
+        for (i, (a, e)) in
+            bits(actual)?.iter().zip(&bits(expected)?).enumerate()
+        {
+            assert_eq!(a, e, "{name}, element {i}");
+        }
+        Ok(())
+    }
