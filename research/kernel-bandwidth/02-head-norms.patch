+    fn biased_and_plain_wide_norms_match_candle_bits() -> Result<()> {
+        let device = candle_core::Device::new_cuda(0)?;
+        let mut state = 0x2545_f491_4f6c_dd1du64;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            (state >> 40) as f32 / (1u64 << 24) as f32 - 0.5
+        };
+        let rows = 1031;
+        let mut matrix = |rows: usize, scale: bool| -> Result<Tensor> {
+            let values: Vec<f32> = (0..rows * 1024)
+                .map(|i| {
+                    let band = [1.0, 1e-3, 1e-20, 64.0, 3e4][(i / 1024) % 5];
+                    let offset = if (i / 1024) % 7 == 3 { 50.0 } else { 0.0 };
+                    if scale {
+                        next() * band + offset
+                    } else {
+                        next()
+                    }
+                })
+                .collect();
+            Tensor::from_vec(values, (rows, 1024), &device)?
+                .to_dtype(DType::BF16)
+        };
+        let x = matrix(rows, true)?;
+        let y = matrix(rows, true)?;
+        let weight = (matrix(1, false)?.squeeze(0)? * 3.0)?;
+        let bias = matrix(1, false)?.squeeze(0)?;
+        let wb = Tensor::stack(&[&weight, &bias], 0)?;
+        // Every finite BF16 value, twice, as residual inputs too.
+        let all: Vec<f32> = (0u32..=65535)
+            .map(|v| {
+                if v & 0x7f80 == 0x7f80 {
+                    0.0
+                } else {
+                    f32::from_bits(v << 16)
+                }
+            })
+            .collect();
+        let sweep = Tensor::from_vec(all, (64, 1024), &device)?
+            .to_dtype(DType::BF16)?;
+        WIDE_CALLS.store(0, std::sync::atomic::Ordering::Relaxed);
+        for (x, y) in [(&x, &y), (&sweep, &sweep), (&sweep, &sweep.flip(&[0])?)]
+        {
+            let y = &y.contiguous()?;
+            for eps in [1e-5, 1e-12] {
+                let sum = (x + y)?;
+                let norm = candle_nn::LayerNorm::new(
+                    weight.clone(),
+                    bias.clone(),
+                    eps,
+                );
+                let (actual_sum, actual_norm) = forward_bias(x, y, &wb, eps)?;
+                assert_bits("biased sum", &actual_sum, &sum)?;
+                assert_bits("biased norm", &actual_norm, &sum.apply(&norm)?)?;
+                let zero = candle_nn::LayerNorm::new(
+                    weight.clone(),
+                    weight.zeros_like()?,
+                    eps,
+                );
+                assert_bits(
+                    "plain norm",
+                    &layer_norm(x, &weight, eps)?,
+                    &x.apply(&zero)?,
+                )?;
+            }
+        }
+        assert_eq!(WIDE_CALLS.load(std::sync::atomic::Ordering::Relaxed), 12);
+        Ok(())
+    }
