+/// True when every tensor is contiguous CUDA BF16 on `x`'s device and
+/// starts on an 8-value boundary, `x` is `(rows, 1024)` and the element
+/// count fits the kernels' 32-bit indexing.
+pub(crate) fn wide_eligible(x: &Tensor, others: &[&Tensor]) -> bool {
+    x.device().is_cuda()
+        && x.dims().len() == 2
+        && x.dim(1).is_ok_and(|c| c == 1024)
+        && x.dim(0).is_ok_and(|r| r > 0)
+        && x.elem_count() <= u32::MAX as usize / 2
+        && std::iter::once(x).chain(others.iter().copied()).all(|t| {
+            t.is_contiguous()
+                && t.dtype() == DType::BF16
+                && t.device().same_device(x.device())
+                && t.layout().start_offset() % 8 == 0
+        })
+}
+
+/// `x + y` rounded to BF16, then LayerNorm with weight `wb[0]` and bias
+/// `wb[1]`. Returns `(sum, normalized)`, matching Candle's add followed by
+/// its fused LayerNorm bit for bit.
+pub(crate) fn forward_bias(
+    x: &Tensor,
+    y: &Tensor,
+    wb: &Tensor,
+    eps: f64,
+) -> Result<(Tensor, Tensor)> {
+    if !wide_eligible(x, &[y, wb])
+        || x.dims() != y.dims()
+        || wb.dims() != [2, 1024]
+    {
+        candle_core::bail!("invalid BF16 biased residual norm inputs")
+    }
+    let out = x.apply_op3_no_bwd(
+        y,
+        wb,
+        &WideNorm {
+            eps: eps as f32,
+            residual: true,
+        },
+    )?;
+    Ok((out.get(0)?, out.get(1)?))
+}
+
+/// LayerNorm whose bias is all positive zero, on width-1024 BF16 rows.
+pub(crate) fn layer_norm(
+    x: &Tensor,
+    weight: &Tensor,
+    eps: f64,
+) -> Result<Tensor> {
+    if !wide_eligible(x, &[weight]) || weight.dims() != [1024] {
+        candle_core::bail!("invalid BF16 layer norm inputs")
+    }
+    x.apply_op3_no_bwd(
+        x,
+        weight,
+        &WideNorm {
+            eps: eps as f32,
+            residual: false,
+        },
+    )
+}
