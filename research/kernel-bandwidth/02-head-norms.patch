+/// Launches one of the warp-per-row width-1024 kernels. `wb` holds
+/// `wb_len` values: the weight row, then the bias row when present.
+/// Callers have checked shapes, contiguity and 8-value alignment.
+fn launch_wide(
+    kernel: &'static str,
+    (x, xl): (&CudaStorage, &Layout),
+    (y, yl): (&CudaStorage, &Layout),
+    (wb, wl, wb_len): (&CudaStorage, &Layout, usize),
+    eps: f32,
+    residual: bool,
+) -> Result<(CudaStorage, Shape)> {
+    let (
+        CudaStorageSlice::BF16(xs),
+        CudaStorageSlice::BF16(ys),
+        CudaStorageSlice::BF16(ws),
+    ) = (&x.slice, &y.slice, &wb.slice)
+    else {
+        candle_core::bail!("wide norm requires BF16")
+    };
+    let (rows, cols) = xl.shape().dims2()?;
+    if cols != 1024 || [xl, yl, wl].iter().any(|l| l.start_offset() % 8 != 0) {
+        candle_core::bail!("wide norm requires aligned width-1024 rows")
+    }
+    #[cfg(test)]
+    WIDE_CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let count = rows * cols;
+    let dev = x.device();
+    let func = dev.get_or_load_custom_func(
+        kernel,
+        "vs1_residual_norm",
+        include_str!(concat!(env!("OUT_DIR"), "/residual_norm.ptx")),
+    )?;
+    let x = xs.slice(xl.start_offset()..xl.start_offset() + count);
+    let y = ys.slice(yl.start_offset()..yl.start_offset() + count);
+    let wb = ws.slice(wl.start_offset()..wl.start_offset() + wb_len);
+    let outputs = if residual { 2 } else { 1 };
+    // SAFETY: every output element is written by the kernel.
+    let mut out = unsafe { dev.alloc(outputs * count)? };
+    let r = rows as u32;
+    let mut launch = func.builder();
+    launch
+        .arg(&x)
+        .arg(&y)
+        .arg(&wb)
+        .arg(&mut out)
+        .arg(&r)
+        .arg(&eps);
+    const ROWS_PER_BLOCK: u32 = 4;
+    // SAFETY: shapes, dtype and alignment are checked above and by callers.
+    unsafe {
+        launch.launch(LaunchConfig {
+            grid_dim: (r.div_ceil(ROWS_PER_BLOCK), 1, 1),
+            block_dim: (32, ROWS_PER_BLOCK, 1),
+            shared_mem_bytes: 0,
+        })
+    }
+    .w()?;
+    let shape: Shape = if residual {
+        (2, rows, cols).into()
+    } else {
+        (rows, cols).into()
+    };
+    Ok((
+        CudaStorage {
+            slice: CudaStorageSlice::BF16(out),
+            device: dev.clone(),
+        },
+        shape,
+    ))
+}
