+        xl: &Layout,
+        y: &CudaStorage,
+        yl: &Layout,
+        wb: &CudaStorage,
+        wl: &Layout,
+    ) -> Result<(CudaStorage, Shape)> {
+        let (kernel, wb_len) = if self.residual {
