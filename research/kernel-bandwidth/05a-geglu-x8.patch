 }
+
+__device__ __forceinline__ unsigned int geglu_pair(unsigned int a, unsigned int g) {
+    unsigned int c0 = bf16(normcdff(__uint_as_float((a & 0xffff) << 16)));
+    unsigned int c1 = bf16(normcdff(__uint_as_float(a & 0xffff0000)));
+    return mul_pair(mul_pair(a, c0 | (c1 << 16)), g);
+}
+
+// Eight values per thread with 16-byte accesses; same arithmetic per value
+// as geglu_bf16_pair. `count8` counts uint4 groups; offsets are 8-aligned.
+extern "C" __global__ void geglu_bf16_x8(
+    const uint4 *__restrict__ activation,
+    const uint4 *__restrict__ gate,
+    uint4 *__restrict__ output,
+    unsigned int count8
+) {
+    unsigned int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count8) {
+        const uint4 a = activation[i], g = gate[i];
+        output[i] = make_uint4(
+            geglu_pair(a.x, g.x), geglu_pair(a.y, g.y),
+            geglu_pair(a.z, g.z), geglu_pair(a.w, g.w));
+    }
+}
