+// Eight consecutive columns per thread with 16-byte accesses; identical
+// per-value arithmetic to rope_pair_bf16. Requires dim / 2 % 8 == 0 and
+// 8-aligned views.
+__device__ __forceinline__ unsigned short lo16(unsigned int v) { return v & 0xffff; }
+__device__ __forceinline__ unsigned short hi16(unsigned int v) { return v >> 16; }
+extern "C" __global__ void rope_pair_x8_bf16(
+    const uint4 *__restrict__ q, const uint4 *__restrict__ k,
+    const uint4 *__restrict__ cos, const uint4 *__restrict__ sin,
+    uint4 *__restrict__ out, unsigned int count, unsigned int heads, unsigned int dim
+) {
+    const unsigned int i = blockIdx.x * blockDim.x + threadIdx.x;
+    const unsigned int groups = dim / 16;  // uint4 groups per half row
+    if (i >= count / 16) return;
+    const unsigned int row = i / groups, group = i % groups;
+    const unsigned int a = (row * dim) / 8 + group, b = a + groups;
+    const unsigned int cs = (row / heads) * groups + group;
+    const unsigned int count8 = count / 8;
+    const uint4 c4 = cos[cs], s4 = sin[cs];
+    const uint4 q0 = q[a], q1 = q[b], k0 = k[a], k1 = k[b];
+    const unsigned int c[4] = {c4.x, c4.y, c4.z, c4.w}, s[4] = {s4.x, s4.y, s4.z, s4.w};
+    const unsigned int qa[4] = {q0.x, q0.y, q0.z, q0.w}, qb[4] = {q1.x, q1.y, q1.z, q1.w};
+    const unsigned int ka[4] = {k0.x, k0.y, k0.z, k0.w}, kb[4] = {k1.x, k1.y, k1.z, k1.w};
+    unsigned int oqa[4], oqb[4], oka[4], okb[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        unsigned short r[8];
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const unsigned short cc = h ? hi16(c[j]) : lo16(c[j]);
+            const unsigned short ss = h ? hi16(s[j]) : lo16(s[j]);
+            const unsigned short x0 = h ? hi16(qa[j]) : lo16(qa[j]);
+            const unsigned short x1 = h ? hi16(qb[j]) : lo16(qb[j]);
+            const unsigned short y0 = h ? hi16(ka[j]) : lo16(ka[j]);
+            const unsigned short y1 = h ? hi16(kb[j]) : lo16(kb[j]);
+            r[h] = sub(mul(x0, cc), mul(x1, ss));
+            r[2 + h] = add(mul(x0, ss), mul(x1, cc));
+            r[4 + h] = sub(mul(y0, cc), mul(y1, ss));
+            r[6 + h] = add(mul(y0, ss), mul(y1, cc));
+        }
+        oqa[j] = r[0] | (static_cast<unsigned int>(r[1]) << 16);
+        oqb[j] = r[2] | (static_cast<unsigned int>(r[3]) << 16);
+        oka[j] = r[4] | (static_cast<unsigned int>(r[5]) << 16);
+        okb[j] = r[6] | (static_cast<unsigned int>(r[7]) << 16);
+    }
+    out[a] = make_uint4(oqa[0], oqa[1], oqa[2], oqa[3]);
+    out[b] = make_uint4(oqb[0], oqb[1], oqb[2], oqb[3]);
+    out[count8 + a] = make_uint4(oka[0], oka[1], oka[2], oka[3]);
+    out[count8 + b] = make_uint4(okb[0], okb[1], okb[2], okb[3]);
+}
