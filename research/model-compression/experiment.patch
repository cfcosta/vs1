+// Temporary compression experiments; archived and removed if rejected.
+#[cfg(all(test, feature = "flash-attn"))]
+impl ModernBert {
+    pub(crate) fn experiment_prune_ffn(&mut self, width: usize) -> Result<()> {
+        for layer in &mut self.layers {
+            let mlp = &mut layer.mlp;
+            let a =
+                mlp.wi_act.weight().to_dtype(DType::F32)?.to_vec2::<f32>()?;
+            let g = mlp
+                .wi_gate
+                .weight()
+                .to_dtype(DType::F32)?
+                .to_vec2::<f32>()?;
+            let o = mlp.wo.weight().to_dtype(DType::F32)?.to_vec2::<f32>()?;
+            assert!(width > 0 && width <= a.len());
+            let mut ranked: Vec<(usize, f64)> = (0..a.len())
+                .map(|i| {
+                    let an: f64 =
+                        a[i].iter().map(|v| (*v as f64).powi(2)).sum();
+                    let gn: f64 =
+                        g[i].iter().map(|v| (*v as f64).powi(2)).sum();
+                    let on: f64 =
+                        o.iter().map(|row| (row[i] as f64).powi(2)).sum();
+                    (i, an * gn * on)
+                })
+                .collect();
+            ranked.sort_by(|a, b| b.1.total_cmp(&a.1).then(a.0.cmp(&b.0)));
+            let mut ids: Vec<u32> =
+                ranked[..width].iter().map(|v| v.0 as u32).collect();
+            ids.sort();
+            let ids = Tensor::from_vec(ids, width, mlp.wo.weight().device())?;
+            mlp.wi_act = Linear::new(
+                mlp.wi_act.weight().index_select(&ids, 0)?.contiguous()?,
+                None,
+            );
+            mlp.wi_gate = Linear::new(
+                mlp.wi_gate.weight().index_select(&ids, 0)?.contiguous()?,
+                None,
+            );
+            mlp.wo = Linear::new(
+                mlp.wo.weight().index_select(&ids, 1)?.contiguous()?,
+                None,
+            );
+        }
+        Ok(())
+    }
+}
