+#[cfg(all(test, feature = "flash-attn"))]
+impl ModernBert {
+    pub(crate) fn experiment_ablate(&mut self, kind: &str, ids: &[usize]) {
+        match kind {
+            "block" => {
+                for &i in ids.iter().rev() {
+                    self.layers.remove(i);
+                }
+            }
+            "attention" => {
+                for &i in ids {
+                    self.layers[i].experiment_skip_attention = true;
+                }
+            }
+            "rope" => {
+                for &i in ids {
+                    self.layers[i].attn.experiment_no_rope = true;
+                }
+            }
+            _ => panic!("unknown ablation"),
+        }
+    }
+}
+
+#[cfg(all(test, feature = "flash-attn"))]
+impl ModernBert {
+    pub(crate) fn experiment_quantize(&mut self, bits: usize) -> Result<()> {
+        use candle_core::quantized::{GgmlDType, QMatMul, QTensor};
+        let dtype = match bits {
+            8 => GgmlDType::Q8_0,
+            4 => GgmlDType::Q4_0,
+            _ => panic!("bits"),
+        };
+        for layer in &mut self.layers {
+            let m = &mut layer.mlp;
+            let quant = |linear: &Linear| -> Result<QMatMul> {
+                let w = linear.weight();
+                let cpu = w.to_device(&Device::Cpu)?.to_dtype(DType::F32)?;
+                Ok(QMatMul::QTensor(Arc::new(QTensor::quantize_onto(
+                    &cpu,
+                    dtype,
+                    w.device(),
+                )?)))
+            };
+            m.experiment_quant =
+                Some([quant(&m.wi_act)?, quant(&m.wi_gate)?, quant(&m.wo)?]);
+        }
+        Ok(())
+    }
+    pub(crate) fn experiment_sparse(&mut self) -> Result<()> {
+        for layer in &mut self.layers {
+            for linear in [
+                &mut layer.mlp.wi_act,
+                &mut layer.mlp.wi_gate,
+                &mut layer.mlp.wo,
+            ] {
+                let w = linear.weight();
+                let mut values =
+                    w.to_dtype(DType::F32)?.flatten_all()?.to_vec1::<f32>()?;
+                assert_eq!(w.dim(1)? % 4, 0);
+                for group in values.chunks_exact_mut(4) {
+                    let mut ids = [0, 1, 2, 3];
+                    ids.sort_by(|&a, &b| {
+                        group[a]
+                            .abs()
+                            .total_cmp(&group[b].abs())
+                            .then(a.cmp(&b))
+                    });
+                    group[ids[0]] = 0.0;
+                    group[ids[1]] = 0.0;
+                }
+                *linear = Linear::new(
+                    Tensor::from_vec(values, w.shape(), w.device())?
+                        .to_dtype(w.dtype())?,
+                    None,
+                );
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(all(test, feature = "flash-attn"))]
+impl ModernBert {
+    pub(crate) fn experiment_fp8(&mut self) -> Result<()> {
+        for layer in &mut self.layers {
+            let m = &mut layer.mlp;
+            let quant = |l: &Linear| -> Result<(Tensor, Tensor)> {
+                let w = l.weight().to_dtype(DType::F32)?;
+                let scale =
+                    (w.abs()?.max_keepdim(1)?.clamp(1e-12f32, f32::MAX)?
+                        / 448.0)?;
+                Ok((w.broadcast_div(&scale)?.to_dtype(DType::F8E4M3)?, scale))
+            };
+            m.experiment_fp8 =
+                Some([quant(&m.wi_act)?, quant(&m.wi_gate)?, quant(&m.wo)?]);
+        }
+        Ok(())
+    }
+}
