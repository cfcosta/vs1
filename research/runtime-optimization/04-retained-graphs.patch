+    fn drop(&mut self) {
+        for entry in &self.entries {
+            let dev = entry.input.device().as_cuda_device().unwrap();
+            dev.cuda_stream().context().bind_to_thread().unwrap();
+            entry.input.device().synchronize().unwrap();
+        }
+        self.entries.clear();
+    }
